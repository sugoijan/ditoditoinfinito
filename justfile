# Show available tasks
default:
    @just --list

# Plain HTTP on a LAN address is not a secure context (no gamepads, no
# WebGPU); from another machine, prefer an SSH tunnel to localhost (AGENTS.md).
# Run the frontend locally (requires trunk); `just dev 0.0.0.0` serves the LAN
dev address="127.0.0.1":
    @trunk serve --address {{address}}

# Release build (same as CI; public URL defaults to /ditoditoinfinito/)
build public_url="/ditoditoinfinito/":
    @trunk build --release --public-url "{{public_url}}"

# Reproduce the README gameplay image offscreen, on a fixed clock.
screenshot scenario="docs/screenshots/readme.json" output="docs/screenshots/readme.png":
    @cargo run -q -p xtask -- gen-songs
    @cargo run -q -p xtask -- gen-noteskins
    @DDI_HOME="$PWD/target/scratch/screenshot/home" cargo run -p ddi-desktop --no-default-features --example screenshot -- "{{scenario}}" "{{output}}"

# Reproduce the small, looping README GIF (requires ffmpeg on PATH).
animation scenario="docs/screenshots/animation.json" output="docs/screenshots/readme.gif":
    @command -v ffmpeg >/dev/null || { echo "Install ffmpeg to generate the GIF" >&2; exit 1; }
    @just screenshot "{{scenario}}" "{{output}}"

# Check the web app for wasm32
app-check:
    @cargo check -p ddi -p ddi-opus-worker -p ddi-svg-worker --target wasm32-unknown-unknown

# Check the platform-independent crates natively (the desktop without
# preparing its DanOni importer: DDI_IMPORTER_TEST_ONLY)
core-check:
    @DDI_IMPORTER_TEST_ONLY=1 cargo check -p ddi-chart -p ddi-engine -p ddi-render -p ddi-platform -p ddi-library -p ddi-actor -p ddi-ui -p ddi-theme -p ddi-noteskin -p ddi-lua -p ddi-session -p ddi-shell -p ddi-opus-worker -p ddi-svg-worker -p ddi-desktop -p ddi -p xtask

# Run all checks
check: core-check app-check regen-seo reuse-lint

# Downloads the wasi-sdk and FFmpeg pinned in video/FFMPEG.toml on first run.
# Build the web's software video decoder module into target/video/
video:
    @video/build.sh

# Build the desktop decoder helper's static FFmpeg into target/video/native/
# (cargo build of the desktop runs it by itself; this runs it alone).
video-native:
    @video/build-native.sh

# With no file: generated clips of each codec against ffmpeg's own decode
# (needs ffmpeg with libx264 and Node 22+).
# Check the video decoder on a file, or on generated clips
[positional-arguments]
video-check file="": video
    #!/usr/bin/env bash
    set -euo pipefail
    if [ -z "$1" ]; then exec video/clips.sh; fi
    # A relative path is where `just` was run from.
    file=$1
    case $file in /*) ;; *) file="{{invocation_directory()}}/$file" ;; esac
    exec node --no-warnings video/check.mjs "$file" --png target/video/check.png

# Builds with the importer and the video helper (docs/plans/packaging.md).
# Package the desktop game for this system into target/dist/
package:
    @cargo run -q -p xtask -- gen-songs
    @cargo run -q -p xtask -- gen-noteskins
    @cargo run -q -p xtask -- gen-credits
    @cargo build --locked -p ddi --profile desktop
    @python3 tools/package/package.py dist --app target/desktop/ddi --output-dir target/dist

# Run native unit tests
test:
    @# The bundled songs' and noteskins' indexes the desktop's tests read
    @# (Trunk's builds write them too; a fresh checkout has none).
    @cargo run -q -p xtask -- gen-songs
    @cargo run -q -p xtask -- gen-noteskins
    @# The desktop's DanOni importer is built but not prepared (no JDK).
    @DDI_IMPORTER_TEST_ONLY=1 cargo test -p ddi-chart -p ddi-engine -p ddi-render -p ddi-platform -p ddi-library -p ddi-actor -p ddi-ui -p ddi-theme -p ddi-noteskin -p ddi-lua -p ddi-session -p ddi-shell -p ddi-desktop -p ddi -p xtask --features ddi-platform/decode,ddi-library/nfkd,ddi-ui/layout,ddi-noteskin/raster

# DanOni workspace SDK, desktop probe and pack verifier checks (Python 3 and ffmpeg; no live imports)
danoni-check *args:
    @python3 tools/danoni-dump/check.py {{args}}

# Regenerate the SEO fragments and sitemap from site/seo/metadata.toml
# (trunk also runs this automatically as a pre_build hook)
regen-seo:
    @cargo run -p xtask -- regen-seo

# Verify REUSE/SPDX licensing metadata (REUSE.toml + LICENSES/)
reuse-lint:
    @uvx --from 'reuse[charset-normalizer]' reuse lint

fmt:
    cargo fmt --all

# Update Rust lockfile to latest versions allowed by manifests
update-cargo:
    @cargo update -v

# Clean local artifacts generated by dev workflows
clean:
    @rm -rf dist .trunk target
