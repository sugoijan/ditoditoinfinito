## The start menu: the game's title over a column of choices, each a wide
## button about 380 px wide (the width of about 30 Latin letters).

# Plays alone: opens the song list.
start-singleplayer = Singleplayer

# Playing together, not made yet: the button is grayed out.
start-multiplayer = Multiplayer · Coming soon

start-options = Options

# Who made the game, its songs and the rest; their licenses.
start-credits = Credits

# Desktop only: ends the game.
start-quit = Quit
