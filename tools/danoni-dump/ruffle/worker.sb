; macOS worker: no network, processes, user files or persistent storage.
(version 1)
(deny default)
(import "dyld-support.sb")
(allow process-exec (literal (param "WORKER")))
(allow file-map-executable
    (subpath "/System")
    (subpath "/usr/lib")
    (literal (param "WORKER")))
(allow signal (target self))
(allow sysctl-read)
(allow mach-lookup)
(allow iokit-open)
(allow file-read-metadata)
(allow file-read*
    (subpath "/System")
    (subpath "/usr/lib")
    (subpath "/Library/Apple/System")
    (literal "/dev/random")
    (literal "/dev/urandom")
    (literal (param "WORKER"))
    (subpath (param "INPUT"))
    (subpath (param "OUTPUT")))
(allow file-write* (subpath (param "OUTPUT")))
