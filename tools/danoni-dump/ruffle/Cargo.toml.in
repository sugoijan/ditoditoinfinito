[package]
name = "ddi-ruffle-probe"
version = "0.1.0"
edition = "2024"
license = "MIT"
publish = false

[workspace]

[dependencies]
ruffle_core = { path = "@UPSTREAM@/core" }
ruffle_render_wgpu = { path = "@UPSTREAM@/render/wgpu" }
serde_json = "=1.0.151"
url = "=2.5.8"
async-channel = "=2.5.0"
sha2 = "=0.11.0"
encoding_rs = "=0.8.42"
tracing = "=0.1.44"
tracing-subscriber = "=0.3.23"

[profile.dev]
debug = 0
